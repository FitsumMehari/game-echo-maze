{
  "name": "echo-maze",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0 && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"*.md\"",
    "format:check": "prettier --check src",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.54.1",
    "@types/three": "^0.184.0",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "three": "^0.184.0"
  },
  "engines": {
    "node": ">=22"
  }
}
